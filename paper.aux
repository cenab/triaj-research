\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Baseline comparison on ESI-5. The HistGradientBoosting (HistGB) baseline provides a strong non-neural reference, while the red-focus FL model improves safety metrics relative to the flat FL baseline.}}{12}{figure.caption.6}\protected@file@percent }
\newlabel{fig:baseline-comparison}{{4}{12}{Baseline comparison on ESI-5. The HistGradientBoosting (HistGB) baseline provides a strong non-neural reference, while the red-focus FL model improves safety metrics relative to the flat FL baseline}{figure.caption.6}{}}
\newlabel{fig:baseline-comparison@cref}{{[figure][4][]4}{[1][12][]12}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Safety and utility trade-offs on ESI-5 across the core configurations. The red-focus hierarchical FL variant improves safety relative to the flat FL baseline (higher critical sensitivity; lower under-triage) while maintaining extreme-class recall in the non-DP setting. DP-SGD provides formal privacy ($\varepsilon \approx 1.15$) but substantially degrades extreme-class performance (ESI-1 recall 0.0), which depresses macro-F1 and critical sensitivity despite high overall accuracy.}}{13}{figure.caption.7}\protected@file@percent }
\newlabel{fig:safety-tradeoff}{{5}{13}{Safety and utility trade-offs on ESI-5 across the core configurations. The red-focus hierarchical FL variant improves safety relative to the flat FL baseline (higher critical sensitivity; lower under-triage) while maintaining extreme-class recall in the non-DP setting. DP-SGD provides formal privacy ($\varepsilon \approx 1.15$) but substantially degrades extreme-class performance (ESI-1 recall 0.0), which depresses macro-F1 and critical sensitivity despite high overall accuracy}{figure.caption.7}{}}
\newlabel{fig:safety-tradeoff@cref}{{[figure][5][]5}{[1][12][]13}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Clinical Safety Metrics}{13}{subsection.5.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Clinical safety diagnostics (ESI-5). Critical sensitivity is recall for the critical band (ESI-2/ESI-1).}}{13}{table.caption.8}\protected@file@percent }
\newlabel{tab:safety}{{3}{13}{Clinical safety diagnostics (ESI-5). Critical sensitivity is recall for the critical band (ESI-2/ESI-1)}{table.caption.8}{}}
\newlabel{tab:safety@cref}{{[table][3][]3}{[1][13][]13}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Row-normalized confusion matrices (ESI-5). In cross-silo FL, the flat FedAvg baseline shows substantial under-triage from ESI-3 toward lower acuity, while the red-focus hierarchical variant improves critical-band discrimination. The DP-SGD run fails to predict ESI-1 (0.0 recall) and concentrates predictions in the mid-acuity classes, which reduces macro-F1 and critical sensitivity despite high overall accuracy.}}{14}{figure.caption.9}\protected@file@percent }
\newlabel{fig:confusion-matrices}{{6}{14}{Row-normalized confusion matrices (ESI-5). In cross-silo FL, the flat FedAvg baseline shows substantial under-triage from ESI-3 toward lower acuity, while the red-focus hierarchical variant improves critical-band discrimination. The DP-SGD run fails to predict ESI-1 (0.0 recall) and concentrates predictions in the mid-acuity classes, which reduces macro-F1 and critical sensitivity despite high overall accuracy}{figure.caption.9}{}}
\newlabel{fig:confusion-matrices@cref}{{[figure][6][]6}{[1][13][]14}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Privacy-Utility Trade-Off with Differential Privacy}{14}{subsection.5.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces DP run (3 sites, 5 rounds; $\sigma =1.0$, $\delta =10^{-5}$): composed privacy budget (max client) and validation accuracy.}}{14}{table.caption.10}\protected@file@percent }
\newlabel{tab:dp-eps-acc}{{4}{14}{DP run (3 sites, 5 rounds; $\sigma =1.0$, $\delta =10^{-5}$): composed privacy budget (max client) and validation accuracy}{table.caption.10}{}}
\newlabel{tab:dp-eps-acc@cref}{{[table][4][]4}{[1][14][]14}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces DP-SGD privacy accounting and utility (3 sites, 5 rounds; $\sigma =1.0$; $\delta =10^{-5}$). Left: validation accuracy and composed privacy budget $\varepsilon $ (max client) across rounds. Right: a privacy--utility view using the composed $\varepsilon $ on the x-axis. Validation accuracy reaches $\sim $84\% by Round~2--5 at $\varepsilon \approx 1.15$, but the DP model fails to predict ESI-1 (0.0 recall), highlighting that accuracy alone can mask extreme-class failures under DP.}}{15}{figure.caption.11}\protected@file@percent }
\newlabel{fig:privacy-utility}{{7}{15}{DP-SGD privacy accounting and utility (3 sites, 5 rounds; $\sigma =1.0$; $\delta =10^{-5}$). Left: validation accuracy and composed privacy budget $\varepsilon $ (max client) across rounds. Right: a privacy--utility view using the composed $\varepsilon $ on the x-axis. Validation accuracy reaches $\sim $84\% by Round~2--5 at $\varepsilon \approx 1.15$, but the DP model fails to predict ESI-1 (0.0 recall), highlighting that accuracy alone can mask extreme-class failures under DP}{figure.caption.11}{}}
\newlabel{fig:privacy-utility@cref}{{[figure][7][]7}{[1][15][]15}{}{}{}}
