\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Byzantine robustness evaluation (non-IID; 7 clients; 10 rounds). Under a poisoning attack, FedAvg exhibits a large accuracy drop and severe over-triage, while median aggregation recovers utility and reduces attack-induced over-triage.}}{16}{figure.caption.12}\protected@file@percent }
\newlabel{fig:byzantine}{{8}{16}{Byzantine robustness evaluation (non-IID; 7 clients; 10 rounds). Under a poisoning attack, FedAvg exhibits a large accuracy drop and severe over-triage, while median aggregation recovers utility and reduces attack-induced over-triage}{figure.caption.12}{}}
\newlabel{fig:byzantine@cref}{{[figure][8][]8}{[1][15][]16}{}{}{}}
